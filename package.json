{
  "name": "learn-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run content && vite dev --host 0.0.0.0",
    "build": "npm run content && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "prepare": "svelte-kit sync",
    "content": "node --import tsx scripts/build-content.ts",
    "check": "npm run content && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run content && vitest run",
    "test:e2e": "npm run content && playwright test",
    "format": "prettier --write --plugin prettier-plugin-svelte \"src/**/*.{svelte,ts,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.js\""
  },
  "dependencies": {
    "katex": "0.18.7",
    "marked": "18.0.13",
    "sanitize-html": "2.17.7",
    "yaml": "2.9.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/mcp": "0.1.26",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.2",
    "@types/sanitize-html": "2.16.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
